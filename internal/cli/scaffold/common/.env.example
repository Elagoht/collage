# Copy to .env, which "collage dev", "go run .", "collage export" and the built
# binary all read from the working directory:
#
#	cp .env.example .env
#
# "collage dev" prefers .env.development when there is one. A variable already
# set in your shell, or by the server, wins over the file.

# Signs the forgery tokens forms carry. Empty is fine in development; set one
# before deploying, or forms submitted before a restart are refused after it.
# Make one with: openssl rand -hex 32
COLLAGE_CSRF_KEY=

PORT=6060
HOST=localhost

# The origin readers reach the site at: what a sitemap, a canonical link or a
# feed puts in front of a path. "collage dev" sets it to its own address when
# this is left commented out; set it where production runs.
# BASE_URL=https://example.com
