package documents

import (
	"context"
	"encoding/json"
	"fmt"
	"time"

	"github.com/Elagoht/collage/pkg/collage"
)

// Returns the health check: JSON at /healthz, rendered without a template so it
// cannot start failing because a page did.
func Health() *collage.Document {
	return collage.NewDocument("health", "application/json").
		WithPath("en", "/healthz").
		WithHandler(sayOk).
		Dynamic().
		Build()
}

// Types the health check's answer.
type healthResponse struct {
	Status string    `json:"status"`
	Date   time.Time `json:"date"`
}

// Answers that the program is up, and when it said so.
func sayOk(
	_ context.Context,
	_ *collage.RenderContext,
) ([]byte, []string, error) {
	body, err := json.MarshalIndent(healthResponse{
		Status: "ok",
		Date:   time.Now().UTC(),
	}, "", "\t")
	if err != nil {
		return nil, nil, fmt.Errorf("health: marshal: %w", err)
	}
	return body, nil, nil
}
