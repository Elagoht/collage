package main

import (
	"fmt"

	"@@MODULE@@/actions"
	"@@MODULE@@/documents"
	demopages "@@MODULE@@/pages/demo"
	errorpages "@@MODULE@@/pages/errors"
	landingpages "@@MODULE@@/pages/landing"

	"github.com/Elagoht/collage/pkg/collage"
)

// Registers every page, document and action to app. A new route goes here;
// "collage add" puts the ones it writes here too.
func register(app *collage.App) error {
	if err := app.Register(
		landingpages.Home(),
		demopages.Features(),
		demopages.Hello(),
		documents.Health(),
		// Actions a page attaches with WithActionFor are registered with it;
		// this one has a URL of its own.
		actions.Count(),
	); err != nil {
		return err
	}

	// Registered rather than given a path: it is reached by failing to match.
	// "collage export" writes it as 404.html.
	if err := app.RegisterNotFoundPage(errorpages.NotFoundPage()); err != nil {
		return fmt.Errorf("register not-found page: %w", err)
	}
	return nil
}
