# Copy to .env.development for "collage dev":
#
#	cp .env.example .env.development
#
# "collage dev" reads .env.development, or .env when there is none. A variable
# already set in your shell wins over the file. Nothing else reads these files:
# in production the environment comes from wherever the binary runs.

# Signs the forgery tokens forms carry. Empty is fine in development; set one
# before deploying, or forms submitted before a restart are refused after it.
# Make one with: openssl rand -hex 32
COLLAGE_CSRF_KEY=

PORT=3000
HOST=localhost
