package actions

import (
	"context"
	"net/http"

	"@@MODULE@@/store"

	"github.com/Elagoht/collage/pkg/collage"
)

func CountAction() *collage.Action {
	return collage.NewAction("count").
		WithPath("en", "/api/count").
		WithMethods(http.MethodPost).
		WithHandler(increment).
		Build()
}

type countResponse struct {
	Count int64 `json:"count"`
}

func increment(context.Context, *collage.RenderContext) (*collage.ActionResult, error) {
	result, err := collage.JSONOf(http.StatusOK, countResponse{Count: store.Increment()})
	if err != nil {
		return nil, err
	}
	// The features page is cached and shows the count, so this is what keeps it
	// true: its entry is dropped, and the next reader gets a fresh render.
	result.InvalidateTags = []string{store.CountTag}
	return result, nil
}
