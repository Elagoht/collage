package actions

import (
	"context"
	"net/http"

	"@@MODULE@@/data/count"

	"github.com/Elagoht/collage/pkg/collage"
)

// Returns the action the counter button posts to, at a URL of its own.
func Count() *collage.Action {
	return collage.NewAction("count").
		WithPath("en", "/api/count").
		WithMethods(http.MethodPost).
		WithHandler(countHandler()).
		Build()
}

// Types the count action's JSON answer.
type countResponse struct {
	Count int64 `json:"count"`
}

// Adds one to the count and answers with the new value as JSON.
func countHandler() collage.ActionHandlerFunc {
	return func(
		_ context.Context,
		_ *collage.RenderContext,
	) (*collage.ActionResult, error) {
		result, err := collage.JSON(http.StatusOK, countResponse{Count: count.Increment()})
		if err != nil {
			return nil, err
		}
		// The features page is cached and shows the count, so this is what keeps
		// it true: its entry is dropped, and the next reader gets a fresh render.
		result.InvalidateTags = []string{count.Tag}
		return result, nil
	}
}

// Returns the action the hello form posts to. It has no path of its own: the
// hello page attaches it with WithActionFor, so it answers at the page's URL, and
// it shares the page's name.
func Hello() *collage.Action {
	return collage.NewAction("hello").
		WithMethods(http.MethodPost).
		WithHandler(helloHandler()).
		Build()
}

// Answers the hello form with the page it was posted to, which is rc.Page; that
// page's data handler reads the name from the post.
func helloHandler() collage.ActionHandlerFunc {
	return func(
		_ context.Context,
		rc *collage.RenderContext,
	) (*collage.ActionResult, error) {
		return collage.RenderPage(rc.Page), nil
	}
}
