package demo

import (
	"context"
	"time"

	"@@MODULE@@/store"

	"github.com/Elagoht/collage/pkg/collage"
)

type counterView struct {
	Count int64
}

func Counter() *collage.Fragment {
	return collage.NewFragment("demo-counter", "fragments/demo/counter.html").
		WithDataHandler(collage.DataHandler(counterData)).
		Build()
}

// counterData reads the count through Cached. store.Count stands in for a database
// query: every page and every fragment path that shows the count shares one read,
// kept until the count action invalidates store.CountTag. Once would share it only
// within one render.
func counterData(_ context.Context, rc *collage.RenderContext) (counterView, []string, error) {
	count, err := collage.Cached(rc, "demo:count", time.Hour, []string{store.CountTag},
		func(context.Context) (int64, error) { return store.Count(), nil })
	return counterView{Count: count}, nil, err
}
