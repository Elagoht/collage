package pages

import (
	"context"
	"strings"
	"time"

	"@@MODULE@@/fragments/layouts"

	"github.com/Elagoht/collage/pkg/collage"
)

const nameKey = "hello:name"

type helloView struct {
	Name       string
	RenderedAt time.Time
}

func HelloPage() *collage.Page {
	content := collage.NewFragment("hello-content", "pages/hello.html").
		WithDataHandler(collage.Load(helloData)).
		Build()

	return collage.NewPage("hello").
		WithLayouts(layouts.Layout()).
		WithContent(content).
		WithPath("en", "/hello").
		WithAction("POST", greet).
		Dynamic().
		Build()
}

// greet answers the form with the page it was posted from, which is rc.Page.
func greet(_ context.Context, rc *collage.RenderContext) (*collage.ActionResult, error) {
	if name := strings.TrimSpace(rc.Request.PostFormValue("name")); name != "" {
		rc.Set(nameKey, name)
	}
	return collage.RenderPage(rc.Page), nil
}

func helloData(_ context.Context, rc *collage.RenderContext) (helloView, error) {
	name := "stranger"
	// Set by greet, the page's action, when this render is its answer.
	if submitted, ok := collage.Get[string](rc, nameKey); ok {
		name = submitted
	}
	return helloView{Name: name, RenderedAt: time.Now()}, nil
}
