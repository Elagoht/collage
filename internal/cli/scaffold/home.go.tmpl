package main

import (
	"context"
	"html"
	"html/template"
	"net/mail"
	"strings"
	"sync"

	"github.com/Elagoht/collage/pkg/collage"
)

// layout is the shell every page renders inside. {{slot "content"}} in
// templates/layouts/default.html marks where a page's own content goes, and
// {{hoist "head"}} marks where fragments contribute to its <head>.
func layout() *collage.Fragment {
	return collage.NewFragment("layout", "layouts/default.html").
		WithSlot("content", true, false).
		Build()
}

// title declares this page's <title>, which the layout's {{hoist "head"}} puts
// in the document head.
//
// Hoisting is how a fragment contributes something that belongs to the page
// rather than to itself. A content fragment renders inside the <body>, long
// after the <head> was written, so it cannot put a title there by itself — it
// declares one, and the engine substitutes it at the marker once the whole tree
// has rendered.
//
// The key is what makes one declaration the same as another: declare "title"
// twice and the innermost fragment wins, which is what "more specific" means in
// a tree. That is also how a plugin contributes — collage-jsonld hoists its
// structured data into the same area.
func title(rc *collage.RenderContext, text string) {
	rc.Hoist("head", "title", template.HTML("<title>"+html.EscapeString(text)+"</title>"))
}

// ---------------------------------------------------------------------------
// The home page: a data handler, and nothing that depends on the request
// ---------------------------------------------------------------------------

// homeView is what templates/pages/home.html renders with. A data handler
// returns one of these; the template reads its fields.
type homeView struct {
	// Links are rendered as a list. They come from Go rather than from the
	// template so that the wiring is visible: this is where a real page would
	// reach a database or an API instead.
	Links []link
}

type link struct {
	Label string
	Href  string
}

// homePage is served at "/".
//
// Static, so "collage export" renders it to a file: its output does not depend
// on the request, and a page that says so is a page that can be a file.
func homePage() *collage.Page {
	content := collage.NewFragment("home-content", "pages/home.html").
		WithDataHandler(collage.DataHandler(homeData)).
		Build()

	return collage.NewPage("home").
		WithLayout(layout()).
		WithContent(content).
		WithPath("en", "/").
		Static().
		Build()
}

// homeData fetches what the home page renders with.
//
// A data handler returns the view, the cache dependency tags the render
// depends on, and an error. Returning an error fails the fragment; what
// happens then is the fragment's own policy — see Required and WithFallback.
//
// It returns its own type rather than any: collage.DataHandler adapts it to
// what the framework takes, so nothing in this project has to box its views.
//
// Sibling fragments' handlers run concurrently, so a handler that fetches
// something another one also needs should use collage.Once rather than reading
// and writing shared data itself.
func homeData(ctx context.Context, rc *collage.RenderContext) (homeView, []string, error) {
	title(rc, "@@NAME@@")

	return homeView{Links: []link{
		{Label: "Try the form", Href: "/signup"},
		{Label: "The stylesheet", Href: "/static/app.css"},
	}}, nil, nil
}

// ---------------------------------------------------------------------------
// The sign-up page: a form, end to end
// ---------------------------------------------------------------------------

// signUpView is what templates/pages/signup.html renders with.
type signUpView struct {
	// Error is why the last submission was refused, when this render is the
	// one the form's action produced after a validation failure.
	Error string
	// Email is what the reader typed, echoed back so a refused form is not
	// also an empty one.
	Email string
	// Signed reports that the reader arrived from a successful submission.
	Signed bool
}

// signUpForm is the page the action re-renders after a refused submission.
//
// It holds the registered page rather than building a fresh one, and that is not
// a detail: registration is what binds a page's content fragment into its
// layout, so a page built on the spot renders its layout around an empty slot
// and produces nothing. collage refuses to serve that, so the mistake is a 500
// rather than a blank page — but it is still a mistake, and this is how to
// avoid it.
var signUpForm *collage.Page

// signUpPage is the form, at "/signup".
//
// It is a separate page from the home page for a reason worth knowing early: a
// form needs a server to post to, so a page carrying one cannot be part of a
// static build. Keeping it separate means "collage export" still writes the
// home page and skips only this one, saying why.
//
// The form posts to the page it is on, which is what an HTML form does by
// default — so the POST is declared here rather than given a URL of its own.
func signUpPage() *collage.Page {
	content := collage.NewFragment("signup-content", "pages/signup.html").
		WithDataHandler(collage.DataHandler(signUpData)).
		Build()

	signUpForm = collage.NewPage("signup").
		WithLayout(layout()).
		WithContent(content).
		WithPath("en", "/signup").
		Dynamic().
		WithAction("POST", signUp).
		Build()

	return signUpForm
}

// signUpData fetches what the form page renders with, including whatever the
// action left behind after a refused submission.
func signUpData(ctx context.Context, rc *collage.RenderContext) (signUpView, []string, error) {
	title(rc, "Sign up — @@NAME@@")

	var view signUpView

	// On an ordinary page view there is nothing here, which is the same code
	// path as a refused submission: no branch, no session, no flash storage.
	if reason, ok := rc.Get("signup:error"); ok {
		view.Error, _ = reason.(string) // any: SharedData's values are the application's own
	}
	if typed, ok := rc.Get("signup:email"); ok {
		view.Email, _ = typed.(string) // any: SharedData's values are the application's own
	}
	view.Signed = rc.Request != nil && rc.Request.URL.Query().Get("signed") == "1"

	return view, nil, nil
}

// signUp handles the form.
//
// The two outcomes are deliberately different in kind, and the difference is
// worth copying into your own forms.
//
// A refused submission renders the page again, with 422 and the reason. The
// reader is going to fix it and send it again, so resubmitting is the intended
// next step — and what they typed is still in the form. The handler and the
// render share one RenderContext, so what rc.Set stores here is what
// signUpData above reads.
//
// An accepted one redirects. The work is done, and a 303 makes the browser's
// next request a GET of somewhere else, so reloading cannot do it twice.
func signUp(ctx context.Context, rc *collage.RenderContext) (*collage.ActionResult, error) {
	if err := rc.Request.ParseForm(); err != nil {
		return nil, err
	}
	address := strings.TrimSpace(rc.Request.PostFormValue("email"))

	if reason := invalidAddress(address); reason != "" {
		rc.Set("signup:error", reason)
		rc.Set("signup:email", address)
		result := collage.RenderPage(signUpForm)
		result.Status = 422
		return result, nil
	}

	signups.add(address)

	return collage.SeeOther("/signup?signed=1"), nil
}

// invalidAddress returns why address cannot be accepted, or the empty string.
func invalidAddress(address string) string {
	switch {
	case address == "":
		return "An email address is required."
	case len(address) > 254:
		return "That address is too long."
	}
	if _, err := mail.ParseAddress(address); err != nil {
		return "That does not look like an email address."
	}
	return ""
}

// ---------------------------------------------------------------------------
// State
// ---------------------------------------------------------------------------

// store is what this project keeps between requests. A map, because a scaffold
// is not a database — collage holds no state of its own, so this is the one
// place to put yours.
type store struct {
	mu   sync.Mutex
	list map[string]struct{}
}

var signups = &store{list: make(map[string]struct{})}

func (s *store) add(address string) {
	s.mu.Lock()
	defer s.mu.Unlock()
	s.list[address] = struct{}{}
}

// ---------------------------------------------------------------------------
// The not-found page
// ---------------------------------------------------------------------------

// notFoundPage is served when a request resolves to nothing.
//
// It is registered with RegisterNotFoundPage rather than given a path of its own:
// it is reached by failing to match, not by matching. A static export writes it
// as 404.html — one per locale — which is the file a static host answers an
// unknown URL with. Without one, that answer comes from the host: somebody
// else's page, in somebody else's language, with no way back to this site.
//
// Dynamic, because a 404 is never worth caching. The export writes it anyway:
// whether a page is worth caching and whether it belongs in an export are
// different questions.
func notFoundPage() *collage.Page {
	content := collage.NewFragment("not-found-content", "pages/404.html").
		WithDataHandler(collage.DataHandler(func(_ context.Context, rc *collage.RenderContext) (struct{}, []string, error) {
			title(rc, "Not found — @@NAME@@")
			return struct{}{}, nil, nil
		})).
		Build()

	return collage.NewPage("not-found").
		WithLayout(layout()).
		WithContent(content).
		Dynamic().
		Build()
}

// ---------------------------------------------------------------------------
// Operations
// ---------------------------------------------------------------------------

// healthDocument answers "/healthz" with a fixed body, which is what a container
// orchestrator, a load balancer or an uptime check asks for.
//
// A document rather than a page: it returns bytes and a content type rather than
// rendering templates, so a health check cannot start failing because a template
// did. Dynamic, so the answer is always this process saying it is up rather than
// something cached from when it was.
func healthDocument() *collage.Document {
	return collage.NewDocument("health", "application/json").
		WithPath("en", "/healthz").
		WithHandler(func(context.Context, *collage.RenderContext) ([]byte, []string, error) {
			return []byte(`{"status":"ok"}`), nil, nil
		}).
		Dynamic().
		Build()
}
